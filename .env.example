# Copy this file to .env on each machine and fill in values. Do not commit .env.

# Neo4j (required when USE_GRAPH_DEMO is 0 or unset)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# 1 = full offline demo (20 patients, AI, upload, benchmark). 0 = use Neo4j above.
USE_GRAPH_DEMO=1

# Optional: OpenAI for /ask-agent and related features when not in demo-only use.
# OPENAI_API_KEY=
